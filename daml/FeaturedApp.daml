module FeaturedApp where

-- FlowLedger application-provider identity metadata.
--
-- Reward attribution is intentionally NOT implemented by creating legacy
-- FeaturedAppActivityMarker contracts here. On networks where CIP-0104
-- traffic-based app rewards are enabled, those markers earn no rewards.
-- Settlement code should instead use the target network's current Token
-- Standard / Featured App attribution mechanism and verify results via Scan.
template FlowLedgerAppProvider
  with
    provider : Party
    dso : Party
  where
    signatory provider
    observer dso
